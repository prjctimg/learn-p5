{
  "name": "learn-p5",
  "main": "expo-router/entry",
  "version": "0.6.128",
  "scripts": {
    "postinstall": "npm run bundle-p5 && npm run bundle-validation && npm run gen-reference && npm run build-courses",
    "start": "npm run bundle-p5 && npm run bundle-validation && npm run gen-reference && npm run build-courses && npm run bundle-editor && expo start",
    "gen-reference": "node scripts/generate-reference.mjs",
    "bundle-p5": "node scripts/bundle-p5.mjs",
    "bundle-editor": "node scripts/bundle-editor.mjs",
    "bundle-validation": "node scripts/bundle-validation.mjs",
    "build-courses": "node scripts/build-courses.mjs",
    "check-exercises": "node scripts/check-exercises.mjs",
    "check-symbols": "node scripts/check-symbols.mjs",
    "prepare": "husky",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-javascript": "6.2.3",
    "@codemirror/language": "6.11.0",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.5",
    "@expo/vector-icons": "^15.0.2",
    "@lezer/highlight": "1.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "codemirror": "6.0.1",
    "expo": "~55.0.26",
    "expo-build-properties": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.9",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-sensors": "~55.0.13",
    "expo-status-bar": "~2.2.3",
    "fuse.js": "7.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@lezer/javascript": "^1.5.4",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~55.0.21",
    "esbuild": "^0.25.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.20",
    "js-yaml": "^4.1.0",
    "prettier": "^3.9.5",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|@lezer))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "private": true
}
