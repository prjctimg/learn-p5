{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      },
      "oauth": false
    }
  },
  "plugin": ["./agents/opencode/plugins/entire.ts"],
  "skills": {
    "paths": ["./agents/skills"]
  },
  "instructions": ["AGENTS.md"]
}
